{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumidoku",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Add your custom domain(s) here when ready:
  // "routes": [
  //   { "pattern": "sumidoku.app", "custom_domain": true },
  //   { "pattern": "www.sumidoku.app", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true
  }
}
